<view class="screen"><view wx:if="{{mock}}" class="notice">模拟模式 · 保存仅验证输入格式，真实审核需联调后端</view><view wx:if="{{loading}}" class="empty">正在读取模板…</view><view wx:if="{{error}}" class="panel stack"><view class="error">{{error}}</view><button class="btn soft" bindtap="load">重试</button></view>
 <view wx:if="{{ready}}" class="panel stack"><view class="heading">编辑模板</view><view class="label">模板分类</view><view class="options"><button wx:for="{{categories}}" wx:key="*this" class="option {{category === item ? 'active' : ''}}" data-category="{{item}}" bindtap="changeCategory" disabled="{{saving || saved}}">{{item}}</button></view><label for="template-content" class="label">模板内容</label><textarea id="template-content" class="input" value="{{content}}" bindinput="input" maxlength="500" disabled="{{saving || saved}}" placeholder="围绕预算、需要和使用频率，写一句有帮助的话。"/><view class="form-hint">{{content.length}} / 500</view><view wx:if="{{writeError}}" class="error">{{writeError}}</view><button wx:if="{{!saved}}" class="btn" bindtap="submit" loading="{{saving}}" disabled="{{saving}}">保存模板</button><button wx:else class="btn" bindtap="back">已保存，返回列表</button></view>
</view>
