/* 模板、榜单与收藏共用的列表层级。 */
.screen .list-header { display:flex; justify-content:space-between; align-items:center; gap:20rpx; padding:12rpx 4rpx 30rpx; }
.screen .list-header .title { font-size:40rpx; font-weight:600; }
.screen .list-subtitle { margin-top:10rpx; }
.screen .new-template { flex:none; margin:0; padding:16rpx 20rpx; border-radius:10rpx; background:#07a854; color:#fff; font-size:25rpx; line-height:1.5; }
.screen .segmented { display:flex; gap:6rpx; background:#e9ece9; padding:6rpx; border-radius:12rpx; margin-bottom:24rpx; }
.screen .segment { flex:1; min-width:0; margin:0; padding:17rpx 12rpx; border-radius:9rpx; line-height:1.5; font-size:28rpx; font-weight:400; background:transparent; color:#737873; }
.screen .segment.selected { background:#fff; color:#078544; font-weight:600; box-shadow:0 2rpx 6rpx rgba(26,55,35,.04); }
.screen .segment::after, .screen .new-template::after, .screen .card-action::after { border:0; }
.screen .category-scroll { width:100%; white-space:nowrap; margin-bottom:24rpx; }
.screen .category-strip { display:inline-flex; gap:12rpx; padding:2rpx 0 10rpx; }
.screen .category-chip { display:inline-block; flex:none; margin:0; padding:12rpx 22rpx; font-size:24rpx; line-height:1.5; color:#737873; background:#fff; border:1rpx solid #e7eae7; border-radius:32rpx; }
.screen .category-chip.selected { color:#078544; background:#e9f6ed; border-color:#b9dec4; }
.screen .section-caption { display:flex; justify-content:space-between; align-items:center; gap:12rpx; color:#8a8f8b; font-size:23rpx; margin:4rpx 4rpx 18rpx; }
.screen .quote-card { padding:28rpx; border-radius:16rpx; }
.screen .quote-meta { display:flex; align-items:center; justify-content:space-between; gap:16rpx; margin-bottom:22rpx; }
.screen .quote-category { display:inline-block; color:#078544; background:#edf7f0; border-radius:6rpx; padding:5rpx 12rpx; font-size:22rpx; line-height:1.5; }
.screen .quote-source { color:#969b97; font-size:22rpx; }
.screen .quote-body { font-size:31rpx; line-height:1.9; color:#303833; white-space:pre-wrap; overflow-wrap:anywhere; padding:0 0 26rpx; }
.screen .quote-body.unavailable { color:#929792; font-size:27rpx; }
.screen .card-actions { display:flex; gap:12rpx; padding-top:20rpx; border-top:1rpx solid #f0f1f0; }
.screen .card-action { flex:1; min-width:0; width:0; min-height:70rpx; margin:0; padding:16rpx 8rpx; box-sizing:border-box; border-radius:9rpx; font-size:25rpx; line-height:36rpx; text-align:center; background:#f1f7f2; color:#078544; }
.screen .card-action.quiet { color:#737873; background:#f5f6f5; }
.screen .card-action.delete { color:#b85b50; background:#faf3f2; }
.screen .card-action[disabled], .screen .segment[disabled], .screen .new-template[disabled] { opacity:.5; }
.screen .demo-inline { display:flex; align-items:center; justify-content:space-between; gap:16rpx; padding:18rpx 4rpx 24rpx; color:#7b837c; font-size:23rpx; }
.screen .demo-inline text:last-child { color:#078544; }

/* 分类恢复为可换行的选择按钮，二级范围切换保持独立。 */
.screen .category-choices { display:flex; flex-wrap:wrap; gap:12rpx; margin-bottom:24rpx; }
.screen .category-choices .category-chip { border-radius:10rpx; padding:13rpx 20rpx; }
