<view class="screen"><view wx:if="{{mock}}" class="notice">模拟模式 · 三条演示申请分别展示通过、拒绝和失效结果</view><view class="hero stack"><view class="title">纪念与总结</view><view class="muted">查看已结束申请的总结，生成属于这次决定的纪念卡片。</view></view><view wx:if="{{error}}" class="error">{{error}}</view><button wx:if="{{error}}" class="btn soft" bindtap="retry">重试</button>
<block wx:for="{{items}}" wx:key="application_id"><navigator wx:if="{{item.eligible}}" class="panel entry" url="/pages/artifacts/detail?application_id={{item.application_id}}"><view class="row"><view class="heading">{{item.description}}</view><text class="badge receipt-status {{item.status}}">{{item.statusLabel}}</text></view><view>{{item.priceLabel}}</view><view class="muted">查看总结与纪念卡 →</view></navigator></block><view wx:if="{{loading}}" class="empty">正在加载…</view><button wx:if="{{cursor}}" class="btn soft" bindtap="more" disabled="{{loading}}">更多申请</button><view wx:if="{{!loading && !cursor && !error}}" class="notice">仅展示已同意、已拒绝或已失效申请。撤回申请不自动生成总结。</view></view>
