<view>
  <view class="picker-hint">已选 {{selected.length}} 人，最多 {{max}} 人</view>
  <view wx:for="{{items}}" wx:key="user_id" class="friend">
    <button class="friend-button" data-id="{{item.user_id}}" bindtap="toggle" disabled="{{disabled}}">
      <text>{{item.nickname || '微信好友'}}</text>
      <text class="check"><block wx:for="{{selected}}" wx:for-item="id" wx:key="*this"><text wx:if="{{id === item.user_id}}">已选</text></block></text>
    </button>
  </view>
  <view class="picker-hint" wx:if="{{limitHint}}">{{limitHint}}</view>
  <view class="picker-hint" wx:if="{{loading}}">正在加载好友…</view>
  <view wx:if="{{error}}" class="picker-error">{{error}}</view>
  <button wx:if="{{error || cursor}}" class="picker-more" bindtap="load" disabled="{{loading}}">{{error ? '重试' : '加载更多好友'}}</button>
  <navigator wx:if="{{!loading && !error && !items.length && !cursor}}" class="picker-empty" url="/pages/friends/index">还没有已确认好友，去邀请好友 ›</navigator>
</view>
