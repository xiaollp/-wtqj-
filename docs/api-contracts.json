        "min": 1,
        "max": 64
      },
      "decision": {
        "type": "enum",
        "values": [
          "ACCEPT",
          "REJECT"
        ]
      }
    },
    "friends.list": {
      "cursor": {
        "type": "string",
        "min": 1,
        "max": 4096,
        "optional": true
