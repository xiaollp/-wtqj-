      "idempotency_key": {
        "type": "string",
        "min": 1,
        "max": 64
      }
    },
    "auth.profile": {
      "idempotency_key": {
        "type": "string",
        "min": 1,
        "max": 64
      },
      "nickname": {
        "type": "string",
        "min": 1,
        "max": 64,
        "optional": true
      },
      "avatar_file_id": {
        "type": "string",
        "min": 1,
        "max": 256,
        "optional": true
      }
    },
    "friends.createInvitation": {
      "idempotency_key": {
        "type": "string",
        "min": 1,
        "max": 64
      }
    },
    "friends.claimInvitation": {
      "idempotency_key": {
        "type": "string",
        "min": 1,
        "max": 64
      },
      "token": {
        "type": "string",
        "min": 32,
        "max": 128
      }
    },
    "friends.confirmInvitation": {
      "idempotency_key": {
        "type": "string",
        "min": 1,
        "max": 64
