          "type": "string",
          "min": 1,
          "max": 256
        },
        "min": 0,
        "max": 9,
        "default": [],
        "unique": true
      },
      "approval_hours": {
        "type": "enum",
        "values": [
          12,
          24,
          72
        ],
        "default": 24
      },
      "mode": {
        "type": "enum",
        "values": [
          "NORMAL",
          "JOINT"
        ],
        "default": "NORMAL"
      },
      "approver_ids": {
        "type": "array",
        "item": {
          "type": "string",
          "min": 1,
          "max": 64
        },
        "min": 2,
        "max": 3,
        "optional": true,
        "unique": true,
        "sorted": true
      },
      "review_rule": {
        "type": "enum",
        "values": [
          "ALL_APPROVE",
          "ONE_VETO"
        ],
        "optional": true
      }
    },
